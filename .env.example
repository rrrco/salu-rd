# Contact form. Without this the form validates but cannot send, and falls back
# to showing the email address and WhatsApp number.
RESEND_API_KEY=

# Verified Resend sender. Optional; falls back to Resend's shared onboarding
# address, which is fine for testing but should be a real domain in production.
CONTACT_FROM_EMAIL="SALU Web <web@example.com>"

# Optional. Both default to the values in sanity.config.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
